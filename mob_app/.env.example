// mob_app/.env.example
// Copy this file to .env and fill in your values.

# Backend URL for local development
# Replace with your machine's LAN IP so the phone can reach your laptop
# Do NOT use 'localhost' — the phone can't reach it
EXPO_PUBLIC_API_URL=http://192.168.1.X:5000

# For production builds, leave this empty — app.json's extra.apiUrl will be used
