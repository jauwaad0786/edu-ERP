{
  "expo": {
    "name": "EduERP",
    "slug": "edu-erp-mobile",
    "owner": "jauwaads-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0176d3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onep360.eduerp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0176d3"
      },
      "package": "com.onep360.eduerp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location"
    ],
    "extra": {
      "apiUrl": "https://edu-erp-backend-xoas.onrender.com",
      "appVersion": "1.0.0",
      "buildNumber": "1",
      "eas": {
        "projectId": "364fb3b9-034c-439d-8c05-7462d31e5171"
      }
    }
  }
}
