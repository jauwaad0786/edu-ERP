# ==============================================================================
# Edu-ERP / 1P360 Production Environment Configuration Template
# Copy this file to `.env` and fill in secrets before deploying.
# ==============================================================================

# Flask & Security Configuration
FLASK_ENV=production
FLASK_CONFIG=production
# Generate strong 64-char hex strings: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars

# Database Configuration (PostgreSQL / Neon / Render)
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/edu_erp

# Domain & CORS Origins (Comma-separated for multiple origins)
FRONTEND_URL=https://edu-erp.vercel.app
CORS_ALLOWED_ORIGINS=https://edu-erp.vercel.app,https://1p360.onrender.com

# Background Worker & Scheduler Control
# Set to 'false' on secondary Gunicorn web workers or when running dedicated scheduler process
DISABLE_SCHEDULER=false

# Cloudinary Storage Configuration (for Student & Staff Photos / Documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Features (Groq / OpenAI)
GROQ_API_KEY=
OPENAI_API_KEY=

# MSG91 Communication & OTP Configuration
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
MSG91_OTP_TEMPLATE_ID=
MSG91_SMS_FLOW_ID=
MSG91_SENDER_ID=
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM_EMAIL=
MSG91_EMAIL_FROM_NAME="Edu ERP Support"
MSG91_EMAIL_TEMPLATE_ID=
